{
  "name": "acid-ledger",
  "version": "1.0.0",
  "private": true,
  "description": "A MERN banking ledger demonstrating ACID transactions with account CRUD.",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspace client",
    "start": "npm run start --workspace server",
    "seed": "npm run seed --workspace server",
    "test": "npm run test --workspace server",
    "mongo:start": "bash scripts/start-mongo.sh",
    "mongo:stop": "bash scripts/stop-mongo.sh"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20"
  }
}
